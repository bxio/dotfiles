alias code="open -a 'Windsurf'"

# VSCode Forks
alias cursor="open -a 'Cursor'"
alias windsurf="open -a 'Windsurf'"

# Windsurf
alias ws="open -a 'Windsurf'"
alias wsc="open -a 'Windsurf'"

# VSCode
alias vscode="open -a 'Visual Studio Code'"
alias vs="open -a 'Visual Studio Code'"

alias 1p=op
# Open .zshrc to be editor in VS Code
alias change="open -a 'Cursor' ~/.zshrc"
# Re-run source command on .zshrc to update current terminal session with new settings
alias update="source ~/.zshrc"
# cd into iCloud drive folder in terminal
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs"
# Clear terminal
alias c='clear'
