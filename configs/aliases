# Universal Shell Aliases, should work with both Bash and ZSH.
alias python='/opt/homebrew/bin/python3'

alias fixow='/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister -kill -r -domain local -domain user;killall Finder;echo "Open With has been rebuilt, Finder will relaunch"'

alias k='kubectl'

alias mkdir='mkdir -p'
alias chown='chown -Rv'
alias chmod='chmod -Rv'

alias tar='tar --verbose'
alias logout='sudo pkill -u $USER'
alias log-out='sudo pkill -u $USER'

# different ls command wrappers
# alias ls="gls -lACG --color --group-directories-first"
alias ls='eza -a --icons --git'
# alias ls='lsd -a'

alias d='lsd'
alias da='lsd -a'
alias dda='lsd -la'

# Eza
alias l="eza -l --icons --git -a"
alias lt="eza --tree --level=2 --long --icons --git"
alias ltree="eza --tree --level=2  --icons --git"

# Dirs
alias open.="open ."
alias code.="code ."
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias open.="open ."

# be less destructive
alias rm="trash"

# make nested directories
alias mkdir="mkdir -p"

# sudoed aliases, shell reloading and pretty paths
alias sudo="sudo "
alias reload="exec $SHELL -l"
alias path="echo -e ${PATH//:/\\\n}"

# afk
alias afk="/System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend"

# kiki brew updates, check, and doctor
alias kiki='brew update && brew upgrade && brew cleanup -s; brew doctor'

#jitouch
alias jitouch="pkill Jitouch; sleep 1; nohup ~/Library/PreferencePanes/Jitouch.prefPane/Contents/Resources/Jitouch.app/Contents/MacOS/Jitouch > /dev/null 2>&1 &"

# Git
alias gits='git status'
alias gcm="git commit -m"
alias gcam="git commit -a -m"
alias gp="git push origin HEAD"
alias gco="git pull origin"
alias gst="git status"
alias glog="git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit"
alias gdiff="git diff"
alias gco="git checkout"
alias gb='git branch'
alias gba='git branch -a'
alias gadd='git add'
alias ga='git add -p'
alias gcoall='git checkout -- .'
alias gr='git remote'
alias gre='git reset'

# Docker
alias dco="docker compose"
alias dps="docker ps"
alias dpa="docker ps -a"
alias dl="docker ps -l -q"
alias dx="docker exec -it"

# K8S
# export KUBECONFIG=~/.kube/config
alias k="kubectl"
alias ka="kubectl apply -f"
alias kg="kubectl get"
alias kd="kubectl describe"
alias kdel="kubectl delete"
alias kl="kubectl logs"
alias kgpo="kubectl get pod"
alias kgd="kubectl get deployments"
alias kc="kubectx"
alias kns="kubens"
alias kl="kubectl logs -f"
alias ke="kubectl exec -it"
alias kcns='kubectl config set-context --current --namespace'
alias podname=''

# Recursively delete `.DS_Store` files
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"

# Self installed tools
alias ping='prettyping --nolegend'
alias powershell='pwsh'

# General Aliases

# Code
# alias code="open -a 'Visual Studio Code'"
# alias code="open -a 'Windsurf'"
alias code="open -a 'Cursor'"

# VSCode Forks
alias cursor="open -a 'Cursor'"

# VSCode
alias vscode="open -a 'Visual Studio Code'"
alias vs="open -a 'Visual Studio Code'"

alias 1p=op
# Open .zshrc to be editor in VS Code
alias change="open -a 'Cursor' ~/.zshrc"
# Re-run source command on .zshrc to update current terminal session with new settings
alias update="source ~/.zshrc"
# cd into iCloud drive folder in terminal
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs"
# Clear terminal
alias c='clear'
