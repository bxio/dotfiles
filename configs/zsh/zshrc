#------------------
# Autocompletions
#------------------
# for f in ~/.dotfiles/completions*; do source $f; done

# make completions menu select. Needs to be before compinit.
zstyle ':completion:*' menu select

if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

  autoload -Uz compinit
  compinit
fi

#------------------
# Paths and Environment Variables
#------------------
# Homebrew auto-update to 1 week
export HOMEBREW_AUTO_UPDATE_SECS=86400
# Homebrew path
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"
# Cargo Path
export PATH=$PATH:/Users/bill/.cargo/bin
# GO Path
export PATH=$PATH:$(go env GOPATH)/bin
# uv
export PATH="/Users/bill/.local/bin:$PATH"

#------------------
# Shell Variables
#------------------
# export XDG_CONFIG_total_HOME=${XDG_CONFIG_HOME:-$HOME/.dotfiles/configs}
# Specify VS Code as default editor for the React Native Simulator
export REACT_EDITOR="code -w"
# Set VS Code Insiders as default code editor
export EDITOR="code -w"
# Android SDK
export ANDROID_HOME=~/Library/Android/sdk
# NVM directory variable
export NVM_DIR="$HOME/.nvm"

#------------------
# Zsh hooks
#------------------

HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history

# Why not completions?
fpath=(/usr/local/share/zsh-completions $fpath)
# enable zsh syntax highlighting and autosuggestions
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh

# bind key for history search
bindkey '^[[A' history-substring-search-up # or '\eOA'
bindkey '^[[B' history-substring-search-down # or '\eOB'

#------------------
# Aliases (for a full list of aliases, run `alias`)
#------------------
source ~/.aliases

#------------------
# Miscellaneous
#------------------

# export PATH="/usr/local/opt/qt/bin:$PATH"

# Set Starship ZSH as a prompt
eval "$(starship init zsh)"
# Set Oh My Posh ZSH as a prompt
# eval "$(oh-my-posh init zsh)"

# fzf autocompletions
# [ -f ~/.dotfiles/completions/.fzf.zsh ] && source ~/.dotfiles/completions/.fzf.zsh

# Functions
wttr() {
    local location="${1// /+}"
    test "$#" -gt 0 && shift
    local args=""
    for p in $WTTR_PARAMS "$@"; do
        args+=" --data-urlencode $p "
    done
    curl -fGsS -H "Accept-Language: ${LANG%_*}" $args --compressed "wttr.in/${location}"
}

# Zoxide
eval "$(zoxide init zsh)"

