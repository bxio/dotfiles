[include]
  path = ~/.dotfiles/configs/git-personal.conf
[includeIf "gitdir:~/Developer/"]
  path = ~/.dotfiles/configs/git-work.conf

[core]
  excludesfile = ~/.gitignore
  editor = code

[alias]
  # git new
  new = "!f() { \\\n  git init && \\\n  cp ~/.git-template/.pre-commit-config.yaml . && \\\n  cp -r ~/.git-template/formatting/. .\n  pre-commit install && \\\n  pre-commit install --hook-type pre-push; \\\n}; f"
  # git whoami
  whoami = "!f() { \\\n  git config --get user.name; \\\n  git config --get user.email;\\\n}; f"
  amend = commit --amend --no-edit
  br = branch
  c = commit -am
  ci = commit
  co = checkout
  d = diff
  ds = diff --staged
  e = commit --amend --all
  fp = fetch --prune
  l = log --oneline
  last = log -1 HEAD
  lg = log --graph --oneline --decorate --all
  p = push
  pushf = push --force-with-lease
  s = status -s
  st = status
  sw = switch
  u = pull
  unstage = restore --staged


[url "git@github.com:/"]
  insteadOf = "gh:"
[url "git://github.com/"]
  insteadOf = "github:"
[url "git@gitlab.com:/"]
  insteadOf = "gl:"
[url "git://gitlab.com/"]
  insteadOf = "gitlab:"

[push]
  default = current
  followTags = true

[fetch]
  prune = true

[help]
  autocorrect = 1
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
  defaultBranch = master
  templateDir = /Users/bill/.git-template
