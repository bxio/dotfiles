[include]
  path = ~/.dotfiles/configs/git-personal.conf
[includeIf "gitdir:~/Developer/"]
  path = ~/.dotfiles/configs/git-work.conf

[core]
  excludesfile = ~/.gitignore
  editor = code

[alias]
  new = "!f() { \\\n  git init && \\\n  cp ~/.git-template/.pre-commit-config.yaml . && \\\n  cp -r ~/.git-template/formatting/. .\n  pre-commit install && \\\n  pre-commit install --hook-type pre-push; \\\n}; f"
  c = commit -am
  e = commit --amend --all
  u = pull
  p = push
  co = checkout
  l = log --oneline
  d = diff
  ds = diff --staged
  s = status -s
  st = status
  br = branch
  sw = switch
  ci = commit
  last = log -1 HEAD


[url "git@github.com:/"]
  insteadOf = "gh:"
[url "git://github.com/"]
  insteadOf = "github:"
[url "git@gitlab.com:/"]
  insteadOf = "gl:"
[url "git://gitlab.com/"]
  insteadOf = "gitlab:"

[push]
  default = current
  followTags = true

[fetch]
  prune = true

[help]
  autocorrect = 1
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
  defaultBranch = master
  templateDir = /Users/bill/.git-template
